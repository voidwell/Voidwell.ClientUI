{
  "name": "navigation",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/navigation/src",
  "prefix": "vw",
  "targets": {
    "build": {
      "executor": "@nrwl/angular:ng-packagr-lite",
      "outputs": ["{workspaceRoot}/dist/libs/navigation"],
      "options": {
        "tsConfig": "libs/navigation/tsconfig.lib.json",
        "project": "libs/navigation/ng-package.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/navigation/tsconfig.lib.prod.json"
        }
      }
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["libs/navigation/src/**/*.ts", "libs/navigation/src/**/*.html"]
      },
      "outputs": ["{options.outputFile}"]
    }
  },
  "generators": {
    "@nrwl/angular:component": {
      "style": "scss"
    }
  },
  "tags": ["type:feature", "scope:navigation"]
}
